rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return isAuthenticated() && getUserData().role == role; }

    match /gyms/{gymId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('ADMIN');
    }
    match /users/{userId} {
      allow read, update: if isAuthenticated() && (request.auth.uid == userId || hasRole('MANAGER') || hasRole('ADMIN'));
      allow create, delete: if hasRole('ADMIN');
    }
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('MANAGER') || hasRole('ADMIN');
    }
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if hasRole('ATHLETE') && getUserData().isFeePaidCurrentMonth == true;
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.athleteId || hasRole('MANAGER'));
    }
  }
}